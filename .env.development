# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database Configuration - Using your existing Spring Boot setup
DB_HOST=localhost
DB_PORT=15432
DB_USER=bookapp_dev_user
DB_PASSWORD=bookapp_dev_pass
DB_NAME=ishtech_dev_db
DB_SSL=false

# Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Logging
LOG_LEVEL=debug

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-development
TOKEN_EXPIRY=24h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
