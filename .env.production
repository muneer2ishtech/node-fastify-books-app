# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database Configuration
DB_HOST=TODO
DB_PORT=TODO
DB_USER=TODO
#DB_PASSWORD=TODO
DB_NAME=ishtech_prod_db
DB_SSL=false

# Connection Pool Settings
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=info

# Security
#JWT_SECRET=TODO
TOKEN_EXPIRY=1h

# Performance
REQUEST_TIMEOUT=30000
BODY_LIMIT=1048576

# CORS
CORS_ORIGIN=https://ishtech.fi
CORS_CREDENTIALS=true
